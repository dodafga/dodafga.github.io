@@ -657,7 +708,38 @@
 
   function render(){ renderList(); renderPreview(); }
 
-  /* ---------- 下載 ---------- */
+  /* ---------- 手動轉向 ---------- */
+  function rotateDataUrl(dataUrl, deg){
+    return new Promise(function(resolve, reject){
+      if (!deg) { resolve(dataUrl); return; }
+      var img = new Image();
+      img.onload = function(){
+        var w = img.naturalWidth, h = img.naturalHeight;
+        var swap = (deg % 180) !== 0;
+        var c = document.createElement('canvas');
+        c.width  = swap ? h : w;
+        c.height = swap ? w : h;
+        var ctx = c.getContext('2d');
+        ctx.translate(c.width / 2, c.height / 2);
+        ctx.rotate(deg * Math.PI / 180);
+        ctx.drawImage(img, -w / 2, -h / 2);
+        resolve(c.toDataURL('image/jpeg', 0.92));
+      };
+      img.onerror = function(){ reject(new Error('\u65cb\u8f49\u5931\u6557')); };
+      img.src = dataUrl;
+    });
+  }
+
+  function applyRot(ph, delta, reset){
+    var next = reset ? 0 : ((((ph.rot || 0) + delta) % 360) + 360) % 360;
+    ph.rot = next;
+    if (!next) { ph.rotUrl = null; render(); return; }
+    rotateDataUrl(ph.dataUrl, next).then(function(u){
+      ph.rotUrl = u;
+      render();
+    }).catch(function(){ toast('\u65cb\u8f49\u5931\u6557', true); });
+  }
+
