   .pitem .fields textarea{min-height:46px;}
   .pitem .flabel{font-size:11.5px;font-weight:600;color:var(--muted);margin-bottom:3px;display:block;}
 
+  /* 手動轉向工具列 */
+  .pitem .rotbar{display:flex;align-items:center;gap:6px;margin-top:8px;flex-wrap:wrap;
+    padding:6px 8px;background:#f4f8fc;border:1px solid #dbe6f2;border-radius:7px;}
+  .pitem .rotbar .rlab{font-size:11.5px;font-weight:700;color:var(--steel-2);margin-right:2px;}
+  .pitem .rotbar button{font-family:inherit;font-size:12.5px;font-weight:700;cursor:pointer;
+    border:1px solid #c3d4e6;background:#fff;color:var(--steel);border-radius:6px;
+    padding:7px 11px;min-height:34px;display:inline-flex;align-items:center;gap:4px;
+    transition:.15s;line-height:1.2;}
+  .pitem .rotbar button:hover{background:#e8f1fa;border-color:var(--steel-2);}
+  .pitem .rotbar button.primary{background:var(--steel);color:#fff;border-color:var(--steel);}
+  .pitem .rotbar button.primary:hover{background:var(--steel-2);}
+  .pitem .rotbar .rdeg{font-size:11.5px;font-weight:700;color:var(--muted);
+    background:#fff;border:1px solid var(--line);border-radius:20px;padding:2px 9px;margin-left:auto;}
+  .pitem .rotbar .rdeg.on{color:var(--amber);background:var(--amber-bg);border-color:#f0dfb8;}
+  @media(max-width:520px){
+    .pitem .rotbar button{flex:1 1 calc(50% - 3px);justify-content:center;min-height:40px;}
+    .pitem .rotbar .rdeg{flex:1 1 100%;text-align:center;margin-left:0;}
+  }
+
   .empty{text-align:center;padding:26px 12px;color:var(--muted);font-size:13px;}
 
